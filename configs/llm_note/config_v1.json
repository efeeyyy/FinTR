{
  "schema": "fintr_llm_note_config_v1",
  "model": "claude-opus-5-5",
  "effort": "high",
  "prompt_file": "configs/llm_note/prompt_v1.md",
  "output_schema_file": "configs/llm_note/output_schema_v1.json",
  "cli_path": {
    "windows": "%USERPROFILE%\\.local\\bin\\claude.exe",
    "default": "claude"
  },
  "timeout_seconds": 900,
  "version_timeout_seconds": 30,
  "max_packet_bytes": 400000,
  "fallback_window_days": 15,
  "strip_env": ["ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN"]
}
